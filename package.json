{
  "name": "replayable-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "chunk": "tsx scripts/chunk-documents.ts",
    "index": "tsx scripts/build-index.ts",
    "prepare:corpus": "npm run chunk && npm run index",
    "retrieve": "tsx scripts/retrieve.ts",
